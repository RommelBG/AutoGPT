# Bot Autonome EU5 — configuration d'exemple.
# Copiez ce fichier en ".env" et renseignez vos clés API.
# Toutes les variables sont optionnelles : sans clé, le conseiller bascule
# automatiquement en mode "mock" (réponses simulées hors-ligne).

# --- Clés API des fournisseurs LLM ---
CEREBRAS_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
# Coordinateur final (Claude Sonnet 4.6) via l'API Anthropic
ANTHROPIC_API_KEY=

# --- Surcharges de modèles (facultatif) ---
# Conseillers
EU5_MODEL_TRESORIER=qwen-3-32b
EU5_MODEL_CONSTRUCTEUR=deepseek-reasoner
EU5_MODEL_STRATEGE=deepseek-reasoner
EU5_MODEL_CONTRADICTEUR=qwen-3-32b
# Coordinateur
EU5_MODEL_COORDINATEUR=claude-sonnet-4-6

# --- Comportement du bot ---
# Backend mémoire : "auto" (pymem si dispo, sinon mock), "pymem" ou "mock"
EU5_MEMORY_BACKEND=auto
# Backend d'action : "auto" (pyautogui si dispo, sinon mock), "pyautogui" ou "mock"
EU5_ACTION_BACKEND=auto
# Nom du processus du jeu à scanner
EU5_PROCESS_NAME=eu5.exe
# Objectif stratégique global communiqué au conseiller Stratège
EU5_OBJECTIF=Devenir la première puissance économique d'Europe d'ici 1600
# Intervalle de base entre deux cycles de décision (secondes, à vitesse 1x)
EU5_TICK_SECONDS=10
